# REFEREE settings. Copy to `referee.env` (not committed); every command and every resumed run reads it.
# A variable already set in the environment wins. Each project records the settings it ran under (settings.json).

# Where reviews are kept.
# SH_PROJECTS_DIR=/data/referee/projects

# Execution gates (explicit opt-ins).
SH_ALLOW_INSTALL=1
SH_ALLOW_REPO_EXEC=1
SH_ALLOW_SCRIPT_EXEC=1
# SH_ALLOW_NETWORK=1          # default on: clones and public data downloads
# SH_ALLOW_DATA_SEARCH=1      # default on: registry search for datasets a paper names

# Time. A run or check past these ends as a documented RESOURCE BLOCKER, never shortened.
SH_RUN_TIMEOUT_S=3600         # one run (host awake time)
SH_CHECK_BUDGET_S=7200        # all runs of one check
# SH_COMPAT_BUDGET_S=1800     # an engineering compatibility test

# Host. Leave SH_PARALLEL unset to size it from the measured CPUs and container memory.
# SH_PARALLEL=2
# SH_MAX_DATA_GB=20           # acquired public data per check

# Coverage. A plan always gets at least one check per main claim.
# SH_MAX_CHECKS=6
# SH_MAX_FOLLOWUP_CHECKS=3
# SH_REPLICATES=3             # seeds of a fresh run, at least

# Sources a review must never read (records about the papers themselves).
# SH_DENY_SOURCES=ICML-2026-agent-repro

# A larger compute host (example: Linux, 64 CPUs, 256 GB, 4 GPUs). GPUs are detected; each run holds one.
# SH_RUN_TIMEOUT_S=21600
# SH_CHECK_BUDGET_S=86400
# SH_MAX_CHECKS=12
# SH_MAX_DATA_GB=100
