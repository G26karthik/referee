# Remote sandbox execution — copy to `.env.sandbox` and fill in.
#
#   cp .env.sandbox.example .env.sandbox
#
# `.env.sandbox` is git-ignored. Nothing in this harness logs, persists or transmits a
# token value; `harness/sandbox.driver_status` reports only whether one is present.
# Variables already exported in your shell always win over this file.

# --- credentials ------------------------------------------------------------------
# From https://modal.com/settings/tokens, or run `modal token new` (which writes
# ~/.modal.toml instead, and is also found automatically).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- the two gates a remote reproduction needs ------------------------------------
# SH_ALLOW_SANDBOX permits LEASING a machine: creating a sandbox, staging the audited
# commit into it, building the repository's declared stack there. It costs money, so it
# is off by default.
SH_ALLOW_SANDBOX=1
# SH_EXEC_BACKEND routes third-party repository execution to that machine. Code THIS
# harness authored — a generated probe, a noise-floor calibration — always runs locally
# whatever this says, because moving it would measure the sandbox instead of the host.
SH_EXEC_BACKEND=modal
# Staging needs to fetch the commit and install the stack. Both are separate gates and
# both are required: without them the session is refused rather than half-built.
SH_ALLOW_NETWORK=1
SH_ALLOW_INSTALL=1
# And this is still what permits running the authors' code at all. Leaving it closed
# gives you the full preflight — identity, capability, resources, commit verification,
# every refusal named — with nothing executed.
SH_ALLOW_REPO_EXEC=0

# --- what to reserve --------------------------------------------------------------
# Empty means no accelerator, which is the default so a CPU-bound review does not bill
# for one. With no GPU reserved the profile reports NO VRAM, so an experiment that states
# a VRAM demand will not match this backend — that is deliberate, not an oversight.
# Published tiers: T4 L4 A10G A100-40GB A100-80GB L40S H100 H200 B200 (and e.g. "H100:4").
SH_SANDBOX_GPU=
SH_SANDBOX_CPU=4
SH_SANDBOX_MEMORY_MIB=16384
# Declared only — `Sandbox.create` has no disk parameter. Used for requirement matching
# and verified against what the machine reports free once it exists.
SH_SANDBOX_DISK_GIB=50

# --- lifetimes --------------------------------------------------------------------
# The lease ceiling. It has to exceed staging plus every run the paper will make, or the
# session dies mid-experiment and the result is a timeout that says nothing about the
# paper.
SH_SANDBOX_TIMEOUT=3600
# A backstop UNDER the `finally` that releases a lease: if this process is killed, the
# machine terminates itself instead of billing to the ceiling. Set 0 to disable.
SH_SANDBOX_IDLE_TIMEOUT=900
# How long staging may take — a shallow fetch of one commit plus a pip install.
SH_SANDBOX_SETUP_TIMEOUT=2400
SH_SANDBOX_PYTHON=3.12
SH_SANDBOX_APP=single-harness-review
