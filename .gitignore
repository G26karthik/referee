/projects/
/reports/
REFEREE_runs_*/
runs/
*.zip
# Source papers and printed reports (inputs and outputs, not code).
/papers/
*.pdf

# Python and tool caches, environments
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Logs, scratch and temporary outputs
*.log
/tmp/
out_*.txt
snippet*.txt

# Credentials and personal settings (referee.env holds this host's settings; referee.env.example is committed)
.env
.env.*
referee.env
.claude/settings.local.json

# OS and archive leftovers
.DS_Store
Thumbs.db
__MACOSX/

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.out
*.toc
*.bak
